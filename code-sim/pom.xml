<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ziqi</groupId>
  <artifactId>code-sim</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>code-sim</name>
  <url>http://maven.apache.org</url>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <wala.version>1.7.1</wala.version>
    <java-smt.version>6.0.0</java-smt.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
      <version>3.25.10</version>
    </dependency>

    <!-- APTED library for method-level tree edit distance. -->
    <dependency>
      <groupId>eu.mihosoft.ext.apted</groupId>
      <artifactId>apted</artifactId>
      <version>0.1</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
          <useIncrementalCompilation>false</useIncrementalCompilation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <!-- <configuration>
          <mainClass>com.ziqi.codesim.Main</mainClass>
        </configuration> -->
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Fat JAR: bundles all dependencies into one executable jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.ziqi.codesim.ast.AstMain</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>semantic-analysis</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-semantic-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/semantic/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-semantic-test-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/semantic-test/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <semantic.tests.enabled>true</semantic.tests.enabled>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <!-- WALA provides bytecode IR, CFG, call graph, and ICFG infrastructure. -->
        <dependency>
          <groupId>com.ibm.wala</groupId>
          <artifactId>com.ibm.wala.core</artifactId>
          <version>${wala.version}</version>
        </dependency>
        <dependency>
          <groupId>com.ibm.wala</groupId>
          <artifactId>com.ibm.wala.util</artifactId>
          <version>${wala.version}</version>
        </dependency>
        <dependency>
          <groupId>com.ibm.wala</groupId>
          <artifactId>com.ibm.wala.shrike</artifactId>
          <version>${wala.version}</version>
        </dependency>

        <!-- JavaSMT keeps the BinHunt-style semantic verifier solver-agnostic. -->
        <dependency>
          <groupId>org.sosy-lab</groupId>
          <artifactId>java-smt</artifactId>
          <version>${java-smt.version}</version>
        </dependency>
        <!-- SMTInterpol: a PURE-JAVA SMT solver (quantifier-free linear integer/real arithmetic).
             Chosen over Z3 because JavaSMT does not ship a signed Z3 native library for macOS arm64
             (you'd have to compile+sign it yourself); a pure-Java solver needs no native lib and is
             fully portable. Nonlinear goals just return UNKNOWN, which Phase B degrades gracefully
             on. Version pinned to what java-smt 6.0.0 declares. (SMTInterpol's CUP-based SMT-LIB
             parser dep, edu.tum.cs:java-cup, lives only in the sosy-lab repo, not Maven Central; we
             build formulas via the JavaSMT API programmatically, not by parsing text, so it is not
             needed at runtime. If a java_cup class is ever missing, add the sosy-lab Maven repo.) -->
        <dependency>
          <groupId>de.uni-freiburg.informatik.ultimate</groupId>
          <artifactId>smtinterpol</artifactId>
          <version>2.5-1242-g5c50fb6d</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
