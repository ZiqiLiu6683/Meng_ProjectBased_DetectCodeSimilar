.DS_Store

# LaTeX final report (not part of the codebase)
/report/

# Test
/results/bcb_full/
/results/bcb_smoke/
code-sim/results/bcb_full/
!code-sim/results/bcb_smoke/
code-sim/results/bcb_smoke/*
!code-sim/results/bcb_smoke/manifest_v2.csv
